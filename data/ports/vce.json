ortheast of the church of Santa Maria dei Carmini.","wpu":"Scuola Grande dei Carmini","img":"https://thumb.wikimedia.org/wikipedia/commons/thumb/d/d5/Scuola_Grande_dei_Carmini_%28Venice%29.jpg/960px-Scuola_Grande_dei_Carmini_%28Venice%29.jpg?utm_source=en.wikipedia.org&utm_campaign=api&utm_content=thumbnail"},{"n":"Hotel Canal Grande","g":"sights","k":"hotel","la":45.441337,"lo":12.323979,"d":658,"w":"https://www.hotelcanalgrande.it/","ph":"+39 041 2440148","wifi":1},{"n":"Oratorio di San Ludovico","g":"sights","k":"attraction","la":45.432628,"lo":12.320761,"d":665,"w":"https://nuovaicona.org"},{"n":"Leonardo da Vinci","g":"sights","k":"museum","la":45.436872,"lo":12.32559,"d":681,"h":"Mo-Su 10:30-18:00","w":"https://www.davincimuseum.it/"},{"n":"Hotel Nazionale","g":"sights","k":"hotel","la":45.442187,"lo":12.323408,"d":683,"w":"https://www.hotel-nazionale.it/","ph":"+39 041 716133","wifi":1},{"n":"Villa Rosa","g":"sights","k":"hotel","la":45.442974,"lo":12.322154,"d":683,"wifi":1},{"n":"Scuola Grande di San Giovanni","g":"sights","k":"attraction","la":45.438376,"lo":12.325776,"d":686},{"n":"Blue Gallery","g":"sights","k":"gallery","la":45.433783,"lo":12.324181,"d":730},{"n":"Imagina Art Gallery","g":"sights","k":"gallery","la":45.433371,"lo":12.324551,"d":782,"w":"http://imaginacafe.it"},{"n":"Creature di gomma","g":"sights","k":"attraction","la":45.438266,"lo":12.327122,"d":790,"w":"https://www.creaturedigomma.com/"},{"n":"Squero Tramontin","g":"sights","k":"attraction","la":45.431456,"lo":12.321813,"d":818,"w":"https://www.tramontingondole.it/"},{"n":"Hotel San Geremia","g":"sights","k":"hotel","la":45.443186,"lo":12.324619,"d":828,"w":"https://www.283.it/","ph":"+39 041 715562","wifi":1},{"n":"Leonardo da Vinci","g":"sights","k":"museum","la":45.433058,"lo":12.325234,"d":845,"h":"Mo-Sa 10:00-19:00","w":"https://www.leonardoavenezia.com/"},{"n":"Palazzo Cendon - Il Piano Nobile","g":"sights","k":"hotel","la":45.444781,"lo":12.322395,"d":863,"w":"https://www.pala