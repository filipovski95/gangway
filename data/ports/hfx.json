]},{"n":"CIBC","g":"essentials","k":"bank","la":44.64299,"lo":-63.577768,"d":780,"f":["wc"]},{"n":"Pete's Fine Foods","g":"essentials","k":"supermarket","la":44.643224,"lo":-63.577906,"d":795,"ph":"+1-902-425-5700","ad":"1515 Dresden Row","f":["wc"]},{"n":"FedEx","g":"essentials","k":"post_office","la":44.642312,"lo":-63.578243,"d":811,"ad":"5640 Spring Garden Road","f":["wc"]},{"n":"ATM","g":"essentials","k":"atm","la":44.647363,"lo":-63.575014,"d":814,"h":"24/7","f":["wc"]},{"n":"The Westin Nova Scotian","g":"sights","k":"landmark","la":44.640139,"lo":-63.568472,"d":210,"ds":"The Westin Nova Scotian is a Canadian hotel located in Halifax, Nova Scotia, owned and operated by New Castle Hotels and Resorts. It was built in 1928 by the Canadian National Railway as the Nova Scotian Hotel and after several changes of owners and names in the late 20th century became the Westin Nova Scotian in 1996.","wpu":"The Westin Nova Scotian","img":"https://thumb.wikimedia.org/wikipedia/commons/thumb/5/5a/Westin_Nova_Scotian_exterior.jpg/960px-Westin_Nova_Scotian_exterior.jpg?utm_source=en.wikipedia.org&utm_campaign=api&utm_content=thumbnail"},{"n":"St. Matthew's United Church (Halifax, Nova Scotia)","g":"sights","k":"landmark","la":44.643872,"lo":-63.571947,"d":375,"ds":"St. Matthew's United Church is a United Church of Canada church in downtown Halifax, Nova Scotia. The church was founded at the same time as the original colony in 1749 as a home for the various groups of dissenting Protestants who were from New England and who did not follow the Church of England.","wpu":"St. Matthew's United Church (Halifax, Nova Scotia)","img":"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/70/St_Matthews%2C_Halifax.JPG/960px-St_Matthews%2C_Halifax.JPG?utm_source=en.wikipedia.org&utm_campaign=api&utm_content=thumbnail"},{"n":"Old Burying Ground (Halifax, Nova Scotia)","g":"sights","k":"landmark","la":44.6434,"lo":-63.5728,"d":410,"ds":"The Old Burying Ground (also known as St. Paul's Church Cemetery) is a historic cemetery in Halifax, Nova Scotia, Canada. It is located at the intersection of Barrington Street and Spring Garden Road in Downtown Halifax.","wpu":"Old Burying Ground (Halifax, Nova Scotia)","img":"https://thumb.wikimedia.org/wikipedia/commons/thumb/9/91/Welsford-Parker_Monument_at_the_entrance_to_the_Old_Burying_Ground_in_Halifax%2C_Nova_Scotia%2C_Canada.jpg/960px-Welsford-Parker_Monument_at_the_entrance_to_the_Old_Burying_Ground_in_Halifax%2C_Nova_Scotia%2C_Canada.jpg?utm_source=en.wikipedia.org&utm_campaign=api&utm_content=thumbnail"},{"n":"Fort Massey United Church","g":"sights","k":"landmark","la":44.63887,"lo":-63.573321,"d":546,"ds":"Fort Massey United Church, formerly Fort Massey Presbyterian Church, is a United Church of Canada church in Halifax, Nova Scotia.","wpu":"Fort Massey United Church","img":"https://thumb.wikimedia.org/wikipedia/commons/thumb/5/52/Fort_Massey_United_Church_in_Halifax.jpg/960px-Fort_Massey_United_Church_in_Halifax.jpg?utm_source=en.wikipedia.org&utm_campaign=api&utm_content=thumbnail"},{"n":"Statue of Winston Churchill (Halifax)","g":"sights","k":"landmark","la":44.643949,"lo":-63.574403,"d":550,"ds":"Sir Winston Churchill is a bronze sculpture located in Halifax, Nova Scotia, depicting the British prime minister Winston Churchill. The sculpture was created by Oscar Nemon and unveiled in 1980 in front of the Halifax Memorial Library on Spring Garden Road.","wpu":"Statue of Winston Churchill (Halifax)","img":"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/73/CA-halifax-churchill.jpg/960px-CA-halifax-churchill.jpg?utm_source=en.wikipedia.org&utm_campaign=api&utm_content=thumbnail"},{"n":"Georges Island (Nova Scotia)","g":"sights","k":"landmark","la":44.640833,"lo":-63.559722,"d":667,"ds":"Georges Island (named after King George II) is a glacial drumlin and the largest island entirely within the harbour limits of Halifax Harbour located in Nova Scotia's Halifax Regional Municipality. The Island is the location of Fort Charlotte - named after King George III's wife Charlotte. Fort Charlotte was built during Father Le Loutre's War, a year after Citadel Hill (Fort George).","wpu":"Georges Island (Nova Scotia)","img":"https://upload.wikimedia.org/wikipedia/commons/a/a4/Georges_Island_Halifax_Harbour.jpg?utm_source=en.wikipedia.org&utm_campaign=api&utm_content=thumbnail_unscaled"},{"n":"Holy Cross Cemetery (Halifax, Nova Scotia)","g":"sights","k":"landmark","la":44.6391,"lo":-63.576,"d":710,"ds":"Holy Cross Cemetery is a cemetery in Halifax, Nova Scotia, owned and operated by the Roman Catholic Archdiocese of Halifax-Yarmouth. It was constructed in 1843 under the direction of Archbishop William Walsh, on land provided by local authorities. Holy Cross Cemetery replaced the first Catholic cemetery in Halifax, the St.","wpu":"Holy Cross Cemetery (Halifax, Nova Scotia)","img":"https://thumb.wikimedia.org/wikipedia/commons/thumb/6/6b/Holy_Cross_Cemetery_Halifax.jpg/960px-Holy_Cross_Cemetery_Halifax.jpg?utm_source=en.wikipedia.org&utm_campaign=api&utm_content=thumbnail"},{"n":"Cambridge Military Library","g":"sights","k":"landmark","la":44.64432,"lo":-63.5769,"d":749,"ds":"Cambridge Military Library is a library building in Royal Artillery Park in Halifax, Nova Scotia, Canada which was built in 1886. The building was created to house the garrison library collection, which had been moved from various locations in the city since its creation in 1817. It is the oldest non-university public library collection in Canada.","wpu":"Cambridge Military Library","img":"https://thumb.wikimedia.org/wikipedia/commons/thumb/b/ba/Cambridge_Military_Library_Halifax_Nova_Scotia.jpg/960px-Cambridge_Military_Library_Halifax_Nova_Scotia.jpg?utm_source=en.wikipedia.org&utm_campaign=api&utm_content=thumbnail"},{"n":"The Vüze","g":"sights","k":"landmark","la":44.637956,"lo":-63.575756,"d":760,"ds":"The Vüze, formerly known as Fenwick Place and Fenwick Tower, is a residential apartment building in the south end of Halifax, Nova Scotia, Canada. At 106 metres and 33 storeys in height, it was the tallest building in Atlantic Canada from its construction in 1971 until 2023.","wpu":"The Vüze","img":"https://thumb.wikimedia.org/wikipedia/commons/thumb/5/59/The_V%C3%BCze_Halifax.jpg/960px-The_V%C3%BCze_Halifax.jpg?utm_source=en.wikipedia.org&utm_campaign=api&utm_content=thumbnail"},{"n":"St. Paul's Church (Halifax, Nova Scotia)","g":"sights","k":"landmark","la":44.6475,"lo":-63.574722,"d":810,"ds":"St. Paul's Church is a historically evangelical Anglican church in downtown Halifax, Nova Scotia, within the Diocese of Nova Scotia and Prince Edward Island of the Anglican Church of Canada. It is located at the south end of the Grand Parade, an open square in downtown Halifax with Halifax City Hall at the northern end.","wpu":"St. Paul's Church (Halifax, Nova Scotia)","img":"https://thumb.wikimedia.org/wikipedia/commons/thumb/9/9f/Halifax_-_NS_-_St._Paul%E2%80%99s_Church.jpg/960px-Halifax_-_NS_-_St._Paul%E2%80%99s_Church.jpg?utm_source=en.wikipedia.org&utm_campaign=api&utm_content=thumbnail"},{"n":"Park Lane (mall)","g":"sights","k":"landmark","la":44.642764,"lo":-63.578308,"d":819,"ds":"Park Lane is a three-storey shopping mall with 40+ shops in Halifax, Nova Scotia, Canada. It is located on Spring Garden Road and is owned by Universal Properties.","wpu":"Park Lane (mall)","img":"https://upload.wikimedia.org/wikipedia/commons/e/ed/Park_Lane_Mall.jpg?utm_source=en.wikipedia.org&utm_campaign=api&utm_content=thumbnail_unscaled"},{"n":"Grand Parade (Halifax, Nova Scotia)","g":"sights","k":"landmark","la":44.6482,"lo":-63.575,"d":884,"ds":"The Grand Parade (sometimes incorrectly referred to as \"Parade Square\") is a historic military parade square dating from the founding of Halifax in 1749. At the north end of the Grand Parade, is the Halifax City Hall, the seat of municipal government in Nova Scotia's Halifax Regional Municipality. At the south end is St.","wpu":"Grand Parade (Halifax, Nova Scotia)","img":"https://thumb.wikimedia.org/wikipedia/commons/thumb/9/91/Halifax_Grand_Parade.jpg/960px-Halifax_Grand_Parade.jpg?utm_source=en.wikipedia.org&utm_campaign=api&utm_content=thumbnail"},{"n":"All Saints Cathedral (Halifax, Nova Scotia)","g":"sights","k":"landmark","la":44.640444,"lo":-63.579681,"d":940,"ds":"The Cathedral Church of All Saints, also known as All Saints Cathedral, is a cathedral church of the Anglican Church of Canada in Halifax, Nova Scotia. It is the cathedral for the Diocese of Nova Scotia and Prince Edward Island. There is an additional cathedral, St.","wpu":"All Saints Cathedral (Halifax, Nova Scotia)","img":"https://upload.wikimedia.org/wikipedia/commons/1/18/Cathedral_Church_All_Saints.jpg?utm_source=en.wikipedia.org&utm_campaign=api&utm_content=thumbnail_unscaled"},{"n":"Duke Tower","g":"sights","k":"landmark","la":44.649222,"lo":-63.576139,"d":1029,"ds":"Duke Tower is an office building part of the Scotia Square complex in Downtown Halifax, Nova Scotia, Canada. It has approximately 220,000 square feet (2043 square metres) of retail space on 14 floors. The building is connected to the Downtown Halifax Link system and has a ground level entrance on Duke Street and an entrance in Scotia Square Mall.","wpu":"Duke Tower","img":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/16/Duke_Tower.JPG/960px-Duke_Tower.JPG?utm_source=en.wikipedia.org&utm_campaign=api&utm_content=thumbnail"}],"about":{"ds":"Halifax, officially the Halifax Regional Municipality (HRM), is the capital and most populous municipality of the Canadian province of Nova Scotia, and the most populous municipality in Atlantic Canada. It consists of four former municipalities that were amalgamated in 1996: Halifax, Dartmouth, Bedford, and Halifax County. Halifax is an economic centre of Atlantic Canada, home to a concentration of government offices and private companies.","wpu":"Halifax, Nova Scotia","img":"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/74/Halifax_Harbour_Sunset_Skyline%2C_Nova_Scotia_%2824237034620%29.jpg/960px-Halifax_Harbour_Sunset_Skyline%2C_Nova_Scotia_%2824237034620%29.jpg?utm_source=en.wikipedia.org&utm_campaign=api&utm_content=thumbnail"},"wk":"2026-10-18"}