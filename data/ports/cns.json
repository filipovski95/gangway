armacy","la":-16.924343,"lo":145.771179,"d":950},{"n":"Coles","g":"essentials","k":"supermarket","la":-16.923982,"lo":145.77105,"d":958,"w":"https://www.coles.com.au/","ad":"1-21 McLeod Street"},{"n":"ATM","g":"essentials","k":"atm","la":-16.924212,"lo":145.771055,"d":961},{"n":"Suncorp","g":"essentials","k":"bank","la":-16.924398,"lo":145.771054,"d":964},{"n":"Cairns","g":"essentials","k":"wifi","la":-16.925667,"lo":145.77126,"d":975,"wifi":1},{"n":"The Reef Hotel Casino","g":"sights","k":"landmark","la":-16.923333,"lo":145.779167,"d":96,"ds":"The Reef Hotel Casino or Pullman Reef Hotel Casino is the only casino in Cairns, Queensland, Australia. The hotel has 128 hotel rooms and is jointly owned by Casinos Austria International Limited and Accor Casino Investments (Australia) Pty. Ltd.","wpu":"The Reef Hotel Casino","img":"https://thumb.wikimedia.org/wikipedia/commons/thumb/3/3a/The_Reef_Hotel_Casino%2C_2015.JPG/960px-The_Reef_Hotel_Casino%2C_2015.JPG?utm_source=en.wikipedia.org&utm_campaign=api&utm_content=thumbnail"},{"n":"Jack and Newell Building","g":"sights","k":"landmark","la":-16.9252,"lo":145.7793,"d":255,"ds":"Jack and Newell Building is a heritage-listed office building at 29 Wharf Street, Cairns City, Cairns, Cairns Region, Queensland, Australia. It was built in 1911 by Hanson & Sons. It is also known as Bartlam's Ltd, Fearnley & Co.","wpu":"Jack and Newell Building","img":"https://thumb.wikimedia.org/wikipedia/commons/thumb/8/82/Jack_and_Newell_Building%2C_2015.jpg/960px-Jack_and_Newell_Building%2C_2015.jpg?utm_source=en.wikipedia.org&utm_campaign=api&utm_content=thumbnail"},{"n":"Bolands Centre","g":"sights","k":"landmark","la":-16.9233,"lo":145.7774,"d":278,"ds":"Bolands Centre is a heritage-listed department store at Lake Street, Cairns City, Cairns, Cairns Region, Queensland, Australia. Designed by Edward Gregory Waters and built in 1912, the Centre was home to a David Jones department store and a prominent toy shop. It is also known as Boland's Building and Boland's Departmental Store.","wpu":"Bolands Centre","img":"https://thumb.wikimedia.org/wikipedia/commons/thumb/2/24/Bolands_Centre%2C_Cairns%2C_2025.jpg/960px-Bolands_Centre%2C_Cairns%2C_2025.jpg?utm_source=en.wikipedia.org&utm_campaign=api&utm_content=thumbnail"},{"n":"HMAS Cairns (naval base)","g":"sights","k":"landmark","la":-16.935556,"lo":145.777778,"d":1415,"ds":"HMAS Cairns is a Royal Australian Navy (RAN) base located adjacent to the Trinity Inlet on the shore of Trinity Bay in Cairns, Queensland, Australia. Although used regularly as a port-of-call since before World War II, a permanent RAN presence was not established until 1971, when a maintenance and support base for patrol boats was set up. The base was formally commissioned in 1971 as a minor war vessel base.","wpu":"HMAS Cairns (naval base)","img":"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/78/HMAS_Cairns.jpg/960px-HMAS_Cairns.jpg?utm_source=en.wikipedia.org&utm_campaign=api&utm_content=thumbnail"},{"n":"Parramatta Park, Queensland","g":"sights","k":"landmark","la":-16.9244,"lo":145.7625,"d":1868,"ds":"Parramatta Park is a suburb of Cairns in the Cairns Region, Queensland, Australia. In the 2021 census, Parramatta Park had a population of 3,621 people.","wpu":"Parramatta Park, Queensland","img":"https://thumb.wikimedia.org/wikipedia/commons/thumb/b/bf/Apartments_in_Minnie_Street%2C_Parramatta_Park%2C_2018.jpg/960px-Apartments_in_Minnie_Street%2C_Parramatta_Park%2C_2018.jpg?utm_source=en.wikipedia.org&utm_campaign=api&utm_content=thumbnail"},{"n":"Floriana, Cairns","g":"sights","k":"landmark","la":-16.9108,"lo":145.767,"d":1937,"ds":"Floriana is a heritage-listed former private home and now guesthouse at 183–185 The Esplanade, Cairns North, Cairns, Cairns Region, Queensland, Australia. It was designed by Edwin Roy Orchard and built in 1939. It was added to the Queensland Heritage Register on 30 April 2010.","wpu":"Floriana, Cairns","img":"https://thumb.wikimedia.org/wikipedia/commons/thumb/f/f0/Front_elevation%2C_Floriana%2C_2009.jpg/960px-Front_elevation%2C_Floriana%2C_2009.jpg?utm_source=en.wikipedia.org&utm_campaign=api&utm_content=thumbnail"},{"n":"WWII RAN Fuel Installation, Edge Hill","g":"sights","k":"landmark","la":-16.8988,"lo":145.7519,"d":4022,"ds":"WWII RAN Fuel Installation is a heritage-listed former fuel depot and now arts centre at Collins Avenue, Edge Hill, Cairns, Cairns Region, Queensland, Australia. It was built in 1943. It was added to the Queensland Heritage Register on 2 February 2007.","wpu":"WWII RAN Fuel Installation, Edge Hill","img":"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/76/WWII_RAN_Fuel_Installation%2C_Edge_Hill%2C_2008.jpg/960px-WWII_RAN_Fuel_Installation%2C_Edge_Hill%2C_2008.jpg?utm_source=en.wikipedia.org&utm_campaign=api&utm_content=thumbnail"},{"n":"Hydrographic Survey Bench Mark, East Trinity","g":"sights","k":"landmark","la":-16.9034,"lo":145.8119,"d":4033,"ds":"Hydrographic Survey Bench Mark is a heritage-listed survey marker at Bessie Point, off Pine Creek-Yarrabah Road, East Trinity, Cairns Region, Queensland, Australia. It was designed by Royal Navy and built in 1878 by Royal Navy. It is also known as Bessie Point.","wpu":"Hydrographic Survey Bench Mark, East Trinity","img":"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/73/Hydrographic_Survey_Bench_Mark%2C_East_Trinity%2C_2013.jpg/960px-Hydrographic_Survey_Bench_Mark%2C_East_Trinity%2C_2013.jpg?utm_source=en.wikipedia.org&utm_campaign=api&utm_content=thumbnail"}],"about":{"ds":"Cairns (English: KANZ; Yidiny: Gimuy) is a city in the Cairns Region, Queensland, Australia, on the tropical northeast coast of Far North Queensland. In the 2021 census, Cairns had a population of 169,312. The city was founded in 1876 and named after Sir William Wellington Cairns, following the discovery of gold in the Hodgkinson River.","wpu":"Cairns","img":"https://thumb.wikimedia.org/wikipedia/commons/thumb/5/54/Cairns_%28Queensland%29_%28cropped%29.jpg/960px-Cairns_%28Queensland%29_%28cropped%29.jpg?utm_source=en.wikipedia.org&utm_campaign=api&utm_content=thumbnail"},"wk":"2026-10-18"}